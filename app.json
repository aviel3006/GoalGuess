{
  "expo": {
    "name": "GoalGuess",
    "slug": "GoalGuess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goalguess",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.goalguess.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goalguess.app",
      "adaptiveIcon": {
        "backgroundColor": "#16E37A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06150D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoalGuess צריכה גישה לתמונות שלך כדי שתוכל לבחור תמונת פרופיל ותמונה לליגה.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9084340459613767~5200276152",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "המזהה הזה ישמש להצגת פרסומות מותאמות עבורך, כדי שנוכל להמשיך להציע את האפליקציה בחינם."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4c2fb7a-3e32-4335-b177-c9dd7cb439da"
      }
    },
    "owner": "goalguess",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c4c2fb7a-3e32-4335-b177-c9dd7cb439da"
    }
  }
}
